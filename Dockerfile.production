FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
# curl: for healthcheck and installing uv
# git: often needed for installing dependencies from git
RUN apt-get update && apt-get install -y \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Copy dependency files
COPY pyproject.toml uv.lock ./

# Install dependencies
# --no-dev: production only
# --no-install-project: we install the project separately
RUN uv sync --frozen --no-dev --no-install-project

# Copy application code
COPY butterscout/ ./butterscout/

# Create non-root user
RUN useradd -m -u 1000 butterscout && \
    chown -R butterscout:butterscout /app

USER butterscout

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health/live || exit 1

# Run application
# Use direct path to venv python to avoid uv run overhead if desired, 
# but uv run is fine. Let's use the venv directly for purity.
ENV PATH="/app/.venv/bin:$PATH"
CMD ["uvicorn", "butterscout.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
