# ============================================================================
# Butterscout Environment Configuration
# ============================================================================
# Copy this file to .env and customize as needed
# Use: cp .env.example .env

# ============================================================================
# Service URLs (Configured automatically by Docker Compose)
# ============================================================================
# These should match the service names in docker-compose.yml
BS_SEARXNG_URL=http://searxng:8080
BS_CRAWL4AI_URL=http://crawl4ai:11235
BS_REDIS_URL=redis://redis:6379/0

# Redis password for production deployments (e.g., Dokploy)
# For docker-compose.prod.yml: set this to enable Redis authentication
# Generate with: openssl rand -base64 16
REDIS_PASSWORD=changeme

# SearXNG secret key for session encryption (auto-generated at startup from template)
# PRODUCTION: Set this in GitHub Secrets → injected via CI/CD
# LOCAL DEV: Leave empty - container will auto-generate a random secret
# Generate with: openssl rand -hex 32
SEARXNG_SECRET_KEY=

# ============================================================================
# Security & Authentication
# ============================================================================
# PRODUCTION: Set a strong API key! Generate with: openssl rand -base64 32
# Leave empty to disable API key authentication (not recommended for production)
BS_API_KEY=

# PRODUCTION: Configure allowed origins for CORS
# Use comma-separated list: https://yourdomain.com,https://app.yourdomain.com
# Default "*" allows all origins (only suitable for development)
BS_CORS_ORIGINS=*

# Enable production mode to enforce strict security validations
# Set to true in production to check for:
# - Insecure SearXNG secret key
# - Wildcard CORS origins
# - Missing API key
BS_PRODUCTION_MODE=false

# ============================================================================
# Rate Limiting
# ============================================================================
# Requests per hour per IP address (unauthenticated)
BS_RATE_LIMIT_PER_HOUR=60

# Requests per hour per API key (authenticated)
BS_API_KEY_RATE_LIMIT_PER_HOUR=600

# Global rate limit across all requests
BS_GLOBAL_RATE_LIMIT_PER_HOUR=10000

# ============================================================================
# Search Configuration
# ============================================================================
# Maximum number of search results to return (max: 25)
BS_MAX_RESULTS=10

# Comma-separated list of allowed domains (empty = allow all)
# Example: wikipedia.org,github.com
BS_ALLOWED_DOMAINS=

# Comma-separated list of blocked domains (empty = block none)
# Example: spam.com,malicious.net
BS_BLOCKED_DOMAINS=

# ============================================================================
# Content Extraction Configuration
# ============================================================================
# Maximum number of URLs to extract concurrently
BS_MAX_CONCURRENT_EXTRACTIONS=4

# Timeout for Crawl4AI extraction (milliseconds)
BS_EXTRACTION_TIMEOUT_MS=2500

# Enable fallback extraction if Crawl4AI fails
BS_FALLBACK_ENABLED=true

# Timeout for fallback extraction (milliseconds)
BS_FALLBACK_TIMEOUT_MS=2000

# Maximum workers for fallback extraction
BS_FALLBACK_MAX_WORKERS=2

# Total request timeout budget (milliseconds)
BS_REQUEST_TIMEOUT_MS=6000

# ============================================================================
# Caching
# ============================================================================
# Cache TTL in seconds (3600 = 1 hour)
BS_CACHE_TTL_SECONDS=3600

# ============================================================================
# Observability & Monitoring
# ============================================================================
# Log level: debug, info, warning, error
# PRODUCTION: Use "info" or "warning"
BS_LOG_LEVEL=info

# Enable Prometheus metrics endpoint at /metrics
BS_ENABLE_METRICS=true

# Health check timeout (milliseconds)
BS_HEALTH_TIMEOUT_MS=750
