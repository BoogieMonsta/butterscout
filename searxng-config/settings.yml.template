# SearXNG configuration for Butterscout
# This file configures SearXNG to work optimally with Butterscout API

use_default_settings: true

general:
  instance_name: "butterscout-searxng"
  enable_metrics: false
  # Disable debug mode in production
  debug: false

search:
  # Safe search: 0 = off, 1 = moderate, 2 = strict
  safe_search: 0
  # Disable autocomplete to reduce overhead
  autocomplete: ""
  # Default language
  default_lang: "en"
  # Supported output formats
  formats:
    - html
    - json

server:
  port: 8080
  bind_address: "0.0.0.0"
  # TEMPLATE FILE - DO NOT EDIT settings.yml directly!
  #
  # This placeholder will be replaced by ./scripts/setup-searxng-config.sh
  # The script generates settings.yml from this template with your actual secret.
  #
  # Setup process:
  #   1. Set SEARXNG_SECRET_KEY in your .env file (generate with: openssl rand -hex 32)
  #   2. Run: ./scripts/setup-searxng-config.sh
  #   3. The script creates settings.yml with your secret
  #
  # After initial setup, this is automatic - just deploy with docker compose up
  secret_key: "__SEARXNG_SECRET_KEY__"
  # Disable rate limiter (handled by Butterscout API)
  limiter: false
  # Disable image proxy for better performance
  image_proxy: false
  # Private instance - disables some bot protection and rate limits
  public_instance: false
  # Allow GET requests
  method: "GET"

ui:
  static_use_hash: true
  default_theme: simple
  theme_args:
    simple_style: dark

# Engine configuration
# Note: Only enable engines that don't require API keys for easier setup
# You can customize this based on your needs

engines:
  # Web engines that work without API keys. A single IP gets rate-limited or
  # CAPTCHA'd by some of these from time to time (SearXNG then suspends that
  # engine for a while), so keep several on: results survive any one dropping out.
  # Checked 2026-11-17 on SearXNG 2026.11.17: top-5 relevance 30/30 with this set.
  - name: google
    disabled: false
  - name: google cse
    disabled: false
  - name: duckduckgo
    disabled: false
  - name: brave
    disabled: false
  - name: yahoo
    disabled: false
  # Bing answers with unrelated pages (shops, medical articles) for technical
  # queries and they outrank real results in the merge. Off until that changes.
  - name: bing
    disabled: true

  # Disable engines that require API keys or are unreliable
  - name: wikipedia
    disabled: true
  - name: github
    disabled: true
  - name: stackoverflow
    disabled: true
  - name: wikidata
    disabled: true
  - name: ahmia
    disabled: true
  - name: torch
    disabled: true
  - name: yacy images
    disabled: true

# Disable telemetry and tracking
outgoing:
  request_timeout: 2.0
  max_request_timeout: 10.0
  useragent_suffix: ""
  pool_connections: 100
  pool_maxsize: 20
  enable_http2: true
